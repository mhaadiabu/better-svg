              <div data-fw-show="react-native" class="hidden">
                <div class="mb-3 flex items-center gap-2">
                  <span class="h-1 w-4 bg-acid rounded-none"></span>
                  <h3 class="font-semibold text-[#e8e8e8]">Remote SVG with skeleton loading</h3>
                </div>
                                <CodeBlock code={`import { View } from "react-native";
import { SVG } from "@mhaadi/svg/react-native";

const Skeleton = () =>
  <View style={{ width: 32, height: 32, borderRadius: 4, backgroundColor: "#27272a" }} />;

export function RemoteIcon({ url }) {
  return (
    <SVG
      src={url}
      width={32}
      height={32}
      sanitize
      cache
      loading={<Skeleton />}
      fallback={<Skeleton />}
    />
  );
}`} lang="tsx" />
              </div>

              <div data-fw-show="vue" class="hidden">
                <div class="mb-3 flex items-center gap-2">
                  <span class="h-1 w-4 bg-acid rounded-none"></span>
                  <h3 class="font-semibold text-[#e8e8e8]">Remote SVG with skeleton loading</h3>
                </div>
                                <CodeBlock code={`<script setup lang="ts">
