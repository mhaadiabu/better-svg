---
import Base from "../layouts/Base.astro";
import browser from "../../../../packages/benchmarks/baselines/2026-11-18-release-comparison/browser.json";
import node from "../../../../packages/benchmarks/baselines/2026-11-18-release-comparison/node.json";

const repository = "https://github.com/mhaadiabu/better-svg";
const archive = `${repository}/blob/cf95a27/packages/benchmarks/baselines/2026-11-18-release-comparison`;
const published = node.manifest.betterSvg.published;
const workflows = [
  { id: "released-raw", label: `Better SVG ${published}`, mode: "Named icon" },
  { id: "better-raw", label: "Better SVG current", mode: "Named icon", current: true },
  { id: "better-static", label: "Better SVG current", mode: "Static import", current: true },
  { id: "svgr-raw", label: "vite-plugin-svgr", mode: "Static import" },
  { id: "unplugin-icons", label: "unplugin-icons", mode: "Static import" },
  { id: "released-url", label: `Better SVG ${published}`, mode: "Runtime URL" },
  { id: "better-url", label: "Better SVG current", mode: "Runtime URL", current: true },
  { id: "react-inlinesvg", label: "react-inlinesvg", mode: "Runtime URL" },
  { id: "react-svg", label: "react-svg", mode: "Runtime URL" },
];

const rows = workflows.map((workflow) => {
  const scenario = browser.runs
    .filter((run) => run.profile === workflow.id)
    .flatMap((run) => run.scenarios)
    .find((run) => run.scenario === "grid-24");
  const warmTimes = scenario?.samples
    .filter((sample) =>
      sample.phase === "warm" && sample.status === "ready" &&
      sample.rendered === sample.expected && sample.updates === sample.expected &&
      sample.sizeMismatch === 0 && sample.errors.length === 0
    )
    .map((sample) => sample.readyMs)
    .sort((left, right) => left - right) ?? [];
  const median = warmTimes[Math.floor(warmTimes.length / 2)];
  const profile = node.profiles.find((profile) => profile.profile === workflow.id);
  if (median === undefined || !profile) throw new Error(`Missing benchmark results for ${workflow.id}`);
  return {
    ...workflow,
    median,
    full: profile.javascript.initialGzip,
    sparse: profile.sparseJavascript.initialGzip,
  };
});

const chartMax = Math.ceil(Math.max(...rows.map((row) => row.median)));
const kb = (bytes: number) => `${(bytes / 1000).toFixed(1)} kB`;
---

<Base title="React benchmarks | BetterSVG" description="Compare React SVG render times and JavaScript bundle sizes across Better SVG, SVGR, unplugin-icons, react-inlinesvg, and react-svg.">
  <nav class="sticky top-0 z-50 border-b border-coal-2 bg-coal/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-y-2 px-4 py-4">
      <a href="/" class="font-display text-xl tracking-wider text-[#e8e8e8]">BETTERSVG</a>
      <div class="flex items-center gap-4 text-sm sm:gap-5">
        <a href="/docs" class="text-zinc-400 hover:text-acid transition-colors">Docs</a>
        <a href="/benchmarks" aria-current="page" class="text-acid">Benchmarks</a>
        <a href="/changelog" class="text-zinc-400 hover:text-acid transition-colors">Changelog</a>
      </div>
    </div>
  </nav>

  <main id="main-content" class="mx-auto max-w-5xl px-4 py-12 lg:py-20">
    <h1 class="font-display text-5xl leading-none tracking-wider sm:text-6xl">REACT BENCHMARKS</h1>
    <p class="mt-5 max-w-2xl leading-relaxed text-zinc-400">
      Better SVG {published} and the current implementation, alongside four React SVG tools.
      We measured named icons, static imports, and runtime URLs on November 18, 2026.
    </p>

    <figure aria-labelledby="render-timing" class="mt-10 border border-coal-4 bg-coal-1">
      <figcaption class="border-b border-coal-4 px-4 py-5 sm:px-6">
        <h2 id="render-timing" class="text-lg font-semibold">Time until 24 icons are ready</h2>
        <p class="mt-1 text-sm text-zinc-400">Median of 15 warm remounts in Chromium. Lower is faster.</p>
      </figcaption>
      <ul role="list" class="divide-y divide-coal-4 px-4 sm:px-6">
        {rows.map((row) => (
          <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-2 py-3 sm:grid-cols-[12rem_minmax(0,1fr)_4.5rem]">
            <div>
              <span class:list={["block text-sm font-medium", row.current && "text-acid"]}>{row.label}</span>
              <span class="block text-xs text-zinc-400">{row.mode}</span>
            </div>
            <div aria-hidden="true" class="col-span-2 row-start-2 h-2 bg-coal-4 sm:col-span-1 sm:col-start-2 sm:row-start-1">
              <div
                class:list={["h-full", row.current ? "bg-acid" : "bg-zinc-400"]}
                style={{ width: `${row.median / chartMax * 100}%` }}
              ></div>
            </div>
            <span class="col-start-2 row-start-1 text-right font-mono text-sm tabular-nums sm:col-start-3">{row.median.toFixed(1)} ms</span>
          </li>
        ))}
      </ul>
    </figure>

    <section aria-labelledby="bundle-size" class="mt-14">
      <h2 id="bundle-size" class="text-lg font-semibold">Initial JavaScript</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Gzip sizes include React and page code. The one-icon build uses an icon from the same
        102-file directory as the full-set build. The full-set named profiles put every discovered
        icon in the initial registry. The current one-icon named profile uses default pruning and
        defers the remaining icons. URL profiles load SVG assets separately.
      </p>
      <table class="mt-5 w-full border-collapse border border-coal-4 text-left text-sm">
        <thead class="bg-coal-1 text-zinc-400">
          <tr>
            <th scope="col" class="px-3 py-3 font-medium sm:px-4">Profile</th>
            <th scope="col" class="px-3 py-3 text-right font-medium sm:px-4">One icon</th>
            <th scope="col" class="px-3 py-3 text-right font-medium sm:px-4">Full set</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-coal-4">
          {rows.map((row) => (
            <tr>
              <th scope="row" class="px-3 py-3 font-medium sm:px-4">
                <span class:list={["block", row.current && "text-acid"]}>{row.label}</span>
                <span class="block text-xs font-normal text-zinc-400">{row.mode}</span>
              </th>
              <td class="whitespace-nowrap px-3 py-3 text-right font-mono text-xs tabular-nums sm:px-4">{kb(row.sparse)}</td>
              <td class="whitespace-nowrap px-3 py-3 text-right font-mono text-xs tabular-nums sm:px-4">{kb(row.full)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section aria-labelledby="methodology" class="mt-14 border-t border-coal-4 pt-7">
      <h2 id="methodology" class="text-lg font-semibold">How we ran it</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-zinc-400">
        These measurements come from one Linux desktop running Vite {node.manifest.versions.vite} and
        Chromium. “Better SVG current” uses the runtime source at <code>526a822</code>, the code going
        into 0.5.0. The archived results use its temporary workspace version, {node.manifest.betterSvg.workspace}.
        The full report includes first-use timings, emitted bytes, build and dev timings, and Node SSR.
      </p>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <a href={`${archive}/README.md`} class="text-acid underline underline-offset-4 hover:text-[#e8e8e8]">Workloads and environment</a>
        <a href={`${archive}/report.md`} class="text-acid underline underline-offset-4 hover:text-[#e8e8e8]">Full report</a>
        <a href={`${archive}/browser.json`} class="text-acid underline underline-offset-4 hover:text-[#e8e8e8]">Browser samples</a>
        <a href={`${archive}/node.json`} class="text-acid underline underline-offset-4 hover:text-[#e8e8e8]">Node samples</a>
      </div>
    </section>
  </main>
</Base>
