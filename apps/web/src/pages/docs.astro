---
import Base from "../layouts/Base.astro";
import FrameworkPicker from "../components/FrameworkPicker.astro";
import { adapterExamples } from "../data/adapter-examples";
import { frameworks } from "../data/frameworks";
import svgPkg from "../../../../packages/svg/package.json";

const version = svgPkg.version;
const stateTypes: Record<string, string> = {
  react: "ReactNode",
  "react-native": "ReactNode",
  vue: "slot",
  svelte: "Snippet",
  solid: "JSX.Element",
  astro: "slot",
  angular: "TemplateRef<unknown>",
};

const sections: { id: string; label: string; frameworks?: string }[] = [
  { id: "overview", label: "Overview" },
  { id: "installation", label: "Installation" },
  { id: "usage", label: "Usage" },
  { id: "props", label: "Props" },
  { id: "framework-specifics", label: "Framework Specifics" },
  { id: "source-types", label: "Source Types" },
  { id: "local-discovery", label: "Local discovery" },
  { id: "icon-catalog", label: "Icon catalog" },
  { id: "security", label: "Security" },
  { id: "edge-cases", label: "Edge Cases", frameworks: "react react-native" },
  { id: "examples", label: "Examples", frameworks: "react react-native vue svelte" },
];

const strippedElements = [
  { elem: "<script>", reason: "Arbitrary JS execution" },
  { elem: "<foreignObject>", reason: "Embedded HTML injection" },
  { elem: "<iframe>", reason: "External frame embedding" },
  { elem: "<object>", reason: "Plugin execution vector" },
  { elem: "<embed>", reason: "Plugin execution vector" },
  { elem: "<style>", reason: "Stylesheet injection and script in CSS" },
  { elem: "animate / animateTransform / set", reason: "SMIL-driven attribute injection" },
  { elem: "on* attributes", reason: "Inline event handler XSS" },
  { elem: "unsafe href", reason: "javascript: URL injection" },
  { elem: "unsafe xlink:href", reason: "XLink javascript: URLs" },
];

import CodeBlock from "../components/CodeBlock.astro";
import PmTabs from "../components/PmTabs.astro";
---


<Base
  title="BetterSVG Docs"
  description="Full API reference for @mhaadi/svg, the inline SVG components for React, React Native, Vue, Svelte, Solid, Astro, and Angular."
>
  <!-- NAV -->
  <nav class="sticky top-0 left-0 right-0 z-50 border-b border-coal-2 bg-coal/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 lg:px-4 py-3 lg:py-4">
      <a href="/" class="flex items-center gap-2.5 group">
        <svg class="h-5 w-5 text-acid group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none">
          <path d="M4 8 Q12 2 20 8 Q12 14 4 8Z" fill="currentColor" opacity="0.9"/>
          <path d="M4 16 Q12 10 20 16 Q12 22 4 16Z" fill="currentColor" opacity="0.4"/>
        </svg>
        <span class="font-display text-lg tracking-wider text-[#e8e8e8]">BETTERSVG</span>
      </a>

      <div class="flex items-center gap-4 md:gap-6">
        <div class="relative hidden md:block">
          <input
            id="docs-search"
            type="search"
            placeholder="Search docs..."
            class="w-48 lg:w-64 border border-coal-4 bg-coal-1 px-3 py-1.5 text-xs font-mono text-[#e8e8e8] placeholder:text-zinc-muted focus:border-acid focus:outline-none transition-colors"
            aria-label="Search documentation"
            autocomplete="off"
          />
          <div id="docs-search-results" class="absolute right-0 top-full mt-2 w-72 border border-coal-4 bg-coal-1 shadow-xl hidden" role="listbox" aria-label="Search results"></div>
        </div>
        <span class="hidden sm:block font-mono text-xs text-acid border border-acid/30 rounded-none px-2 py-1">Docs</span>
        <a href="/changelog" class="text-sm text-zinc-muted hover:text-acid transition-colors">Changelog</a>
        <a href="https://github.com/mhaadiabu/better-svg" target="_blank" class="text-sm text-zinc-muted hover:text-acid transition-colors">GitHub</a>
        <a href="https://www.npmjs.com/package/@mhaadi/svg" target="_blank" class="text-sm text-zinc-muted hover:text-acid transition-colors">npm</a>
      </div>
    </div>
  </nav>

  <!-- Mobile sidebar overlay -->
  <div id="docs-mobile-overlay" class="mobile-sidebar-overlay lg:hidden"></div>
  <div id="docs-mobile-panel" class="mobile-sidebar-panel lg:hidden" role="dialog" aria-modal="true" aria-label="Docs menu" tabindex="-1">
    <p class="px-3 mb-2 font-mono text-[10px] tracking-widest text-[#3a3a3a] uppercase">Framework</p>
    <div class="px-3 mb-5">
      <FrameworkPicker
        frameworks={frameworks}
        initial="react"
        id="fw-picker-mobile"
      />
    </div>

    <p class="px-3 mb-2 font-mono text-[10px] tracking-widest text-[#3a3a3a] uppercase">On this page</p>
    <nav class="flex flex-col gap-0.5">
      {sections.map((s) => (
        <a href={`#${s.id}`} class="sidebar-link mobile-sidebar-link" data-section={s.id} data-fw-show={s.frameworks}>
          {s.label}
        </a>
      ))}
    </nav>
  </div>

  <div class="min-h-screen overflow-x-clip">
    <!-- Mobile menu trigger (sticky) -->
    <button id="docs-mobile-sidebar-btn" class="lg:hidden sticky top-13 z-30 w-full flex items-center justify-between gap-2 border-b border-coal-2 bg-coal/95 backdrop-blur-md px-4 py-2.5 text-xs font-mono text-zinc-muted hover:text-acid transition-colors">
      <span class="flex items-center gap-2 min-w-0">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0">
          <line x1="8" y1="6" x2="21" y2="6"/>
          <line x1="8" y1="12" x2="21" y2="12"/>
          <line x1="8" y1="18" x2="21" y2="18"/>
          <line x1="3" y1="6" x2="3.01" y2="6"/>
          <line x1="3" y1="12" x2="3.01" y2="12"/>
          <line x1="3" y1="18" x2="3.01" y2="18"/>
        </svg>
        <span class="truncate">
          <span id="docs-mobile-current-fw" class="text-acid">React</span>
          <span class="text-zinc-muted"> · </span>
          <span data-mobile-section>Overview</span>
        </span>
      </span>
      <svg id="docs-mobile-sidebar-chevron" class="transition-transform shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </button>
    <!-- LEFT SIDEBAR (fixed) -->
    <aside class="hidden lg:block fixed left-0 top-16.25 bottom-0 w-60 overflow-y-auto border-r border-coal-2 py-8 pr-4">
      <div class="mx-auto max-w-7xl px-4 flex flex-col h-full">
        <div>
          <div class="mb-6">
            <p class="px-3 mb-2 font-mono text-[10px] tracking-widest text-[#3a3a3a] uppercase">@mhaadi/svg</p>
            <p class="px-3 text-xs text-zinc-muted">API Reference</p>
          </div>

          <p class="px-3 mb-2 font-mono text-[10px] tracking-widest text-[#3a3a3a] uppercase">Framework</p>
          <div class="px-3 mb-6">
            <FrameworkPicker
              frameworks={frameworks}
              initial="react"
              id="fw-picker-desktop"
            />
          </div>

          <!-- Version badge -->
          <div class="mt-8 mx-3 rounded-none border border-coal-4 bg-coal-1 p-3">
            <p class="font-mono text-[10px] text-[#3a3a3a] mb-1">CURRENT VERSION</p>
            <a href={`/changelog#${version.replaceAll(".", "")}`} aria-label={`Release notes for version ${version}`} class="font-mono text-sm text-acid hover:text-[#e8e8e8] transition-colors">v{version}</a>
          </div>
        </div>
      </div>
    </aside>

    <!-- CONTENT (with left/right sidebar offsets) -->
    <div class="lg:pl-60 lg:pr-48">
      <main id="main-content" class="min-w-0 max-w-4xl mx-auto px-4 lg:px-10 py-8 lg:py-12">

          <!-- Page header -->
          <div class="mb-10 lg:mb-16 pb-8 border-b border-coal-2">
            <div class="mb-3 flex items-center gap-2 font-mono text-xs text-zinc-muted">
              <span>BetterSVG</span>
              <span class="text-coal-4">/</span>
              <span class="text-acid">API Reference</span>
            </div>
            <h1 class="font-display text-6xl tracking-wider text-[#e8e8e8] leading-none mb-4">DOCS</h1>
            <p class="text-zinc-muted max-w-xl leading-relaxed">
              Complete reference for the <code data-fw-show="react react-native vue svelte solid astro" class="inline-code">{"<SVG>"}</code><code data-fw-show="angular" class="inline-code hidden">{"<better-svg>"}</code> component.
              Resolves, sanitizes, and renders SVGs inline from local files, markup, data URLs, or remote URLs.
            </p>
          </div>

          <!-- OVERVIEW -->
          <section id="overview" class="mb-16">
            <h2 class="docs-heading">Overview</h2>
            <p class="docs-body">
              <code class="inline-code">@mhaadi/svg</code> resolves SVG content, sanitizes unsafe markup, and renders it inline.
              <span data-fw-show="react vue svelte solid astro angular"> It renders a real <code class="inline-code">{"<svg>"}</code> DOM element.</span>
              <span data-fw-show="react-native" class="hidden"> It renders a <code class="inline-code">react-native-svg</code> tree.</span>
            </p>

            <div class="mt-6 grid sm:grid-cols-4 gap-4">
              {[
                { label: "Shared SVG core" },
                { label: "TypeScript-first" },
                { label: "Sanitized by default" },
                { label: `${frameworks.length} frameworks` },
              ].map((badge) => (
                <div class="flex items-center gap-2 rounded-none border border-coal-4 bg-coal-1 px-4 py-3">
                  <span class="text-acid text-xs">⬡</span>
                  <span class="font-mono text-xs text-zinc-muted">{badge.label}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- INSTALLATION -->
          <section id="installation" class="mb-16">
            <h2 class="docs-heading">Installation</h2>
            <p class="docs-body">Install the right package for your framework:</p>

            <div class="mt-6 space-y-6">
              <!-- React / RN / Vue / Svelte (one package) -->
              <div data-fw-show="react react-native vue svelte solid astro angular">
                <p class="mb-3 text-sm text-[#e8e8e8] font-semibold">Install the package</p>
                <PmTabs
                  commands={[
                    { pm: "pnpm", cmd: "pnpm add @mhaadi/svg" },
                    { pm: "npm", cmd: "npm install @mhaadi/svg" },
                    { pm: "yarn", cmd: "yarn add @mhaadi/svg" },
                    { pm: "bun", cmd: "bun add @mhaadi/svg" },
                  ]}
                />
                <div class="mt-3 rounded-none border border-coal-4 bg-coal-1 p-4">
                  <p data-fw-show="react" class="font-mono text-xs text-zinc-muted">
                    <span class="text-acid">Peer (React):</span> React 18+ · TypeScript 5+ (optional)
                  </p>
                  <p data-fw-show="react-native" class="hidden font-mono text-xs text-zinc-muted">
                    <span class="text-acid">Peer (RN):</span> react-native, react-native-svg
                  </p>
                  <p data-fw-show="vue" class="hidden font-mono text-xs text-zinc-muted">Requires Vue 3.</p>
                  <p data-fw-show="svelte" class="hidden font-mono text-xs text-zinc-muted">Requires Svelte 5.</p>
                  <p data-fw-show="solid" class="hidden font-mono text-xs text-zinc-muted">Requires Solid 1.9+.</p>
                  <p data-fw-show="astro" class="hidden font-mono text-xs text-zinc-muted">Requires Astro 5+.</p>
                  <p data-fw-show="angular" class="hidden font-mono text-xs text-zinc-muted">Requires Angular 20+.</p>
                  <p class="font-mono text-xs text-zinc-muted">
                    <span class="text-acid">Dependency facts:</span> all framework peers are optional, so install
                    only what you import. <code class="inline-code">@xmldom/xmldom</code> (bundled) is imported
                    only by the Astro and React Native adapters. <code class="inline-code">svgo</code> is an optional,
                    build-time-only peer used by the local-discovery plugins; it never reaches the browser bundle.
                  </p>
                </div>
              </div>

            </div>
          </section>

          <!-- USAGE -->
          <section id="usage" class="mb-16">
            <h2 class="docs-heading">Usage</h2>
            <p class="docs-body">Import the component from the entry point that matches your framework:</p>

            <!-- React -->
            <div data-fw-show="react">
              <CodeBlock code={`import { SVG } from "@mhaadi/svg/react";

// From a registered local name, or /assets/svg/logo.svg
export function MyComponent() {
  return (
    <SVG
      name="logo"
      className="h-6 w-6 text-current"
      aria-label="Logo"
    />
  );
}

// From a remote URL with loading and fallback states
<SVG
  src="https://cdn.example.com/icon.svg"
  sanitize
  loading={<Spinner />}
  fallback={<FallbackIcon />}
  onSvgLoad={(markup) => console.log(markup)}
/>

// From an inline SVG string
const LOGO = \`<svg viewBox='0 0 24 24'>...</svg>\`;

<SVG
  src={LOGO}
  className="h-8 w-8 text-emerald-400"
/>`} lang="tsx" />
            </div>

            <!-- React Native -->
            <div data-fw-show="react-native" class="hidden">
                              <CodeBlock code={`import { SVG } from "@mhaadi/svg/react-native";

export function MyIcon() {
  return (
    <SVG
      name="logo"
      width={24}
      height={24}
      color="#111827"
    />
  );
}`} lang="tsx" />

              <p class="docs-body mt-6">
                The renderer parses the SVG into an AST and emits a{" "}
                <code class="inline-code">react-native-svg</code> tree. Supported nodes:{" "}
                <code class="inline-code">Svg</code>, <code class="inline-code">Path</code>,{" "}
                <code class="inline-code">Rect</code>, <code class="inline-code">Circle</code>,{" "}
                <code class="inline-code">Ellipse</code>, <code class="inline-code">Line</code>,{" "}
                <code class="inline-code">Polyline</code>, <code class="inline-code">Polygon</code>,{" "}
                <code class="inline-code">Text</code>, gradients,{" "}
                <code class="inline-code">ClipPath</code>, <code class="inline-code">Mask</code>,{" "}
                <code class="inline-code">Defs</code>, <code class="inline-code">Use</code>,{" "}
                <code class="inline-code">Symbol</code>, <code class="inline-code">Image</code>. Inline{" "}
                <code class="inline-code">style</code> and <code class="inline-code">class</code> are
                translated into React Native style objects.
              </p>
            </div>

            <!-- Vue -->
            <div data-fw-show="vue" class="hidden">
                              <CodeBlock code={`<script setup lang="ts">
  import { SVG } from "@mhaadi/svg/vue";
</script>

<template>
  <SVG
    src="https://cdn.example.com/icon.svg"
    :width="24"
    :height="24"
    class="h-6 w-6 text-current"
  />

  <SVG src="/icon.svg">
    <template #loading>Loading…</template>
    <template #fallback>Failed</template>
  </SVG>
</template>`} lang="vue" />
              <p class="docs-body mt-4">
                Loading and fallback are exposed as named slots. <code class="inline-code">svg-load</code> and{" "}
                <code class="inline-code">svg-error</code> events are emitted when the markup resolves or fails.
              </p>
            </div>

            <!-- Svelte -->
            <div data-fw-show="svelte" class="hidden">
                              <CodeBlock code={`<script lang="ts">
  import { SVG } from "@mhaadi/svg/svelte";
</script>

<SVG
  src="https://cdn.example.com/icon.svg"
  width="24"
  height="24"
/>

<SVG src="/icon.svg">
  {#snippet loading()}Loading…{/snippet}
  {#snippet fallback()}Failed{/snippet}
</SVG>`} lang="svelte" />
              <p class="docs-body mt-4">
                Svelte 5 uses the runes API. Pass <code class="inline-code">loading</code> and{" "}
                <code class="inline-code">fallback</code> as snippets.
              </p>
            </div>

            {adapterExamples.map((adapter) => (
              <div data-fw-show={adapter.id} class="hidden">
                <CodeBlock code={adapter.code} lang={adapter.lang} />
                <p class="docs-body mt-4">{adapter.details}</p>
              </div>
            ))}

          </section>

          <!-- PROPS -->
          <section id="props" class="mb-16">
            <h2 class="docs-heading">Props</h2>
            <p class="docs-body">
              Source, sanitization, and cache options control how SVGs load and render. Framework-specific extras are
              documented in the <a href="#framework-specifics" class="text-acid hover:underline">Framework Specifics</a> section.
            </p>

            <div class="mt-6 rounded-none border border-coal-4 overflow-x-auto prop-table-wrapper">
              <table class="prop-table">
                <thead>
                  <tr>
                    <th>Prop</th>
                    <th>Type</th>
                    <th>Default</th>
                    <th>Description</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">src</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">string</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                    <td class="text-zinc-muted text-sm">Inline SVG string, data: URL, or remote URL.</td>
                  </tr>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">name</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">string</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                    <td class="text-zinc-muted text-sm">Resolves a registered local SVG by name. Missing names fetch <code class="inline-code">/assets/svg/{"{name}"}.svg</code>.</td>
                  </tr>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">size</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">string | number</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">unset</code></td>
                    <td class="text-zinc-muted text-sm">Set width and height together. Explicit dimensions take precedence.</td>
                  </tr>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">title</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">string</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">unset</code></td>
                    <td class="text-zinc-muted text-sm">Accessible title text. <span data-fw-show="react vue svelte solid astro angular">Renders a title element.</span><span data-fw-show="react-native" class="hidden">Sets the accessibility label.</span></td>
                  </tr>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">desc</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">string</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">unset</code></td>
                    <td class="text-zinc-muted text-sm">Accessible description text. <span data-fw-show="react vue svelte solid astro angular">Renders a desc element.</span><span data-fw-show="react-native" class="hidden">Sets the accessibility hint.</span></td>
                  </tr>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">fill</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">string</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">unset</code></td>
                    <td class="text-zinc-muted text-sm">Overrides <code class="inline-code">fill</code> everywhere it applies; see <a href="#color-overrides" class="text-acid hover:underline">Color overrides</a>.</td>
                  </tr>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">stroke</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">string</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">unset</code></td>
                    <td class="text-zinc-muted text-sm">Overrides <code class="inline-code">stroke</code> everywhere it applies; see <a href="#color-overrides" class="text-acid hover:underline">Color overrides</a>.</td>
                  </tr>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">sanitize</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">boolean</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">true</code></td>
                    <td class="text-zinc-muted text-sm">Removes scripts, event handlers, unsafe hrefs, and embedded HTML.</td>
                  </tr>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">uniqueIds</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">boolean</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">true</code></td>
                    <td class="text-zinc-muted text-sm">Isolate IDs and local references per SVG instance. Disable for intentional external ID references.</td>
                  </tr>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">cache</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">boolean</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">true</code></td>
                    <td class="text-zinc-muted text-sm">Cache remote SVG markup in memory by src URL.</td>
                  </tr>
                  <tr>
                    <td><code class="font-mono text-xs text-acid">fetchOptions</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">RequestInit</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                    <td class="text-zinc-muted text-sm">Options passed to fetch().</td>
                  </tr>
                  <tr data-fw-show="astro" class="hidden">
                    <td><code class="font-mono text-xs text-acid">allowedOrigins</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">readonly string[]</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">same origin</code></td>
                    <td class="text-zinc-muted text-sm">Trusted origins permitted for server fetches, such as <code class="inline-code">https://cdn.example.com</code>. Redirects are rejected.</td>
                  </tr>
                  {frameworks.map((framework) => (
                    <>
                      {framework.id !== "astro" && <tr data-fw-show={framework.id} class:list={{ hidden: framework.id !== "react" }}>
                        <td><code class="font-mono text-xs text-acid">loading</code></td>
                        <td><code class="font-mono text-xs text-[#e8c97e]">{stateTypes[framework.id]}</code></td>
                        <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                        <td class="text-zinc-muted text-sm">Rendered while fetching or parsing SVG.</td>
                      </tr>}
                      <tr data-fw-show={framework.id} class:list={{ hidden: framework.id !== "react" }}>
                        <td><code class="font-mono text-xs text-acid">fallback</code></td>
                        <td><code class="font-mono text-xs text-[#e8c97e]">{stateTypes[framework.id]}</code></td>
                        <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                        <td class="text-zinc-muted text-sm">Rendered when loading or parsing fails.</td>
                      </tr>
                    </>
                  ))}
                  <tr data-fw-show="react react-native svelte solid astro">
                    <td><code class="font-mono text-xs text-acid">onSvgLoad</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">(markup: string) =&gt; void</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                    <td class="text-zinc-muted text-sm">Called after markup is successfully resolved.<span data-fw-show="astro" class="hidden"> Runs on the server.</span></td>
                  </tr>
                  <tr data-fw-show="react react-native svelte solid astro">
                    <td><code class="font-mono text-xs text-acid">onSvgError</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">(error) =&gt; void</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                    <td class="text-zinc-muted text-sm">Called when loading or parsing fails. Receives an <code class="inline-code">Error</code>.<span data-fw-show="astro" class="hidden"> Runs on the server.</span></td>
                  </tr>
                  <tr data-fw-show="vue" class="hidden">
                    <td><code class="font-mono text-xs text-acid">svg-load</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">event: string</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                    <td class="text-zinc-muted text-sm">Emits the resolved SVG markup. Listen with <code class="inline-code">@svg-load</code>.</td>
                  </tr>
                  <tr data-fw-show="vue" class="hidden">
                    <td><code class="font-mono text-xs text-acid">svg-error</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">event: Error</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                    <td class="text-zinc-muted text-sm">Emits an Error when loading or parsing fails. Listen with <code class="inline-code">@svg-error</code>.</td>
                  </tr>
                  <tr data-fw-show="angular" class="hidden">
                    <td><code class="font-mono text-xs text-acid">svgLoad</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">output&lt;string&gt;</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                    <td class="text-zinc-muted text-sm">Emits the resolved SVG markup.</td>
                  </tr>
                  <tr data-fw-show="angular" class="hidden">
                    <td><code class="font-mono text-xs text-acid">svgError</code></td>
                    <td><code class="font-mono text-xs text-[#e8c97e]">output&lt;Error&gt;</code></td>
                    <td><code class="font-mono text-xs text-zinc-muted">none</code></td>
                    <td class="text-zinc-muted text-sm">Emits an Error when loading or parsing fails.</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="mt-6 space-y-4">
              <div id="color-overrides" class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <h3 class="font-mono text-xs tracking-widest text-acid mb-2">COLOR OVERRIDES</h3>
                <p class="text-sm text-zinc-muted">
                  The <code class="inline-code">fill</code> and
                  <code class="inline-code">stroke</code> props rewrite matching
                  presentation attributes on the root and every descendant, including values inside
                  the <code class="inline-code">style</code> attribute. Embedded
                  <code class="inline-code">none</code> values and gradient references
                  (<code class="inline-code">url(#...)</code>) are preserved, and existing
                  <code class="inline-code">!important</code> markers are kept. Attribute values and
                  style declarations that do not match <code class="inline-code">fill</code>/<code class="inline-code">stroke</code>
                  are untouched.
                </p>
                <p class="text-sm text-zinc-muted mt-2">
                  Subtrees inside <code class="inline-code">mask</code> and
                  <code class="inline-code">clipPath</code> are deliberately
                  <strong class="text-[#e8e8e8]">not</strong> overridden: those geometries are keyed
                  by luminance, so recoloring them would erase the artwork they clip.
                </p>
              </div>

              <div id="unique-ids" class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <h3 class="font-mono text-xs tracking-widest text-acid mb-2">WHAT uniqueIds REWRITES</h3>
                <p class="text-sm text-zinc-muted">
                  <code class="inline-code">uniqueIds</code> is on by default (props table) and gives
                  every instance its own id scope, so repeated SVGs can share gradients, masks, clip
                  paths, and local references without collisions. The rewrite covers fragment links
                  (<code class="inline-code">href="#id"</code>, <code class="inline-code">xlink:href</code>),
                  CSS <code class="inline-code">url(#...)</code> values with CSS escaping,
                  accessibility id lists (<code class="inline-code">aria-labelledby</code> and
                  friends), and animation timing references
                  (<code class="inline-code">begin</code>/<code class="inline-code">end</code>).
                  The cached parse keeps its original ids; scoping happens per instance and
                  <code class="inline-code">onSvgLoad</code> still hands you the original markup.
                </p>
                <p class="text-sm text-zinc-muted mt-2">
                  Turn it off only when something outside the component references the original ids
                  by design, such as an external stylesheet or another SVG pointing at this one.
                </p>
              </div>
            </div>
          </section>

          <!-- FRAMEWORK SPECIFICS -->
          <section id="framework-specifics" class="mb-16">
            <h2 class="docs-heading">Framework Specifics</h2>

            <div class="mt-6 space-y-6">
              <!-- React -->
              <div data-fw-show="react">
                <p class="text-sm text-zinc-muted mb-3">
                  Every <code class="inline-code">React.SVGProps{"<SVGSVGElement>"}</code> prop except{" "}
                  <code class="inline-code">children</code> and{" "}
                  <code class="inline-code">dangerouslySetInnerHTML</code> is supported and overrides
                  any attributes parsed from SVG markup. Forwarded via{" "}
                  <code class="inline-code">React.forwardRef</code>.
                </p>
                                <CodeBlock code={`import { SVG } from "@mhaadi/svg/react";
import { SvgName } from "@mhaadi/svg";

const icons: SvgName[] = ["logo", "arrow"];`} lang="tsx" />
              </div>

              <!-- React Native -->
              <div data-fw-show="react-native" class="hidden">
                <p class="text-sm text-zinc-muted mb-3">
                  Accepts the standard source props plus size, color, and paint overrides
                  that are translated to <code class="inline-code">react-native-svg</code> props.
                  <code class="inline-code">color</code> sets the inherited color for icons drawn
                  with <code class="inline-code">currentColor</code>; use{" "}
                  <code class="inline-code">fill</code> or{" "}
                  <code class="inline-code">stroke</code> to override explicit paint.
                </p>
                                <CodeBlock code={`<SVG
  name="logo"
  width={24}
  height={24}
  color="#111827"
  fill="none"
  stroke="currentColor"
  strokeWidth={1.5}
  style={{ margin: 8 }}
/>`} lang="tsx" />
              </div>

              <!-- Vue -->
              <div data-fw-show="vue" class="hidden">
                <p class="text-sm text-zinc-muted mb-3">
                  Root-level SVG attributes (width, height, viewBox, fill, stroke, role,
                  aria-label, aria-hidden) are forwarded. fill and stroke also
                  override matching hardcoded values on descendants. Events are kebab-cased
                  (<code class="inline-code">svg-load</code>, <code class="inline-code">svg-error</code>).
                  Server rendering shows the loading slot until the component mounts in the browser.
                </p>
                                <CodeBlock code={`<SVG
  @svg-load="onLoad"
  @svg-error="onError"
  src="/icon.svg"
  :width="24"
  :height="24"
  role="img"
  aria-label="Icon"
>
  <template #loading>Spinner</template>
  <template #fallback>Fallback</template>
</SVG>`} lang="vue" />
              </div>

              <!-- Svelte -->
              <div data-fw-show="svelte" class="hidden">
                <p class="text-sm text-zinc-muted mb-3">
                  Root-level SVG attributes (width, height, viewBox, fill, stroke, role,
                  aria-label, aria-hidden) are forwarded. fill and stroke also
                  override matching hardcoded values on descendants. Snippet names match the
                  <code class="inline-code">loading</code> and <code class="inline-code">fallback</code>{" "}
                  props.
                  Server rendering shows the loading snippet until the component mounts in the browser.
                </p>
                                <CodeBlock code={`<SVG
  src="/icon.svg"
  class="h-6 w-6 text-current"
>
  {#snippet loading()}Spinner{/snippet}
  {#snippet fallback()}Fallback{/snippet}
</SVG>`} lang="svelte" />
              </div>

              {adapterExamples.map((adapter) => (
                <div data-fw-show={adapter.id} class="hidden">
                  <p class="docs-body mb-4">{adapter.details}</p>
                  <CodeBlock code={adapter.states} lang={adapter.id === "angular" ? "html" : adapter.lang} />
                </div>
              ))}

            </div>
          </section>

          <!-- SOURCE TYPES -->
          <section id="source-types" class="mb-16">
            <h2 class="docs-heading">Source Types</h2>
            <p class="docs-body">Supported SVG sources:</p>

            <div class="mt-6 space-y-4">
              <div class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <div class="flex items-start gap-4">
                  <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-none border border-acid/30 font-display text-base text-acid">1</div>
                  <div class="flex-1 min-w-0">
                    <h3 class="mb-1 font-semibold text-[#e8e8e8]">Inline SVG markup</h3>
                    <p class="text-sm text-zinc-muted">A raw SVG string starting with <code class="inline-code">{"<svg"}</code> or <code class="inline-code">{"<?xml"}</code>. Parsed by DOMParser, sanitized, then inlined.</p>
                  </div>
                </div>
              </div>

              <div class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <div class="flex items-start gap-4">
                  <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-none border border-coal-4 font-display text-base text-zinc-muted">2</div>
                  <div class="flex-1 min-w-0">
                    <h3 class="mb-1 font-semibold text-[#e8e8e8]">data: URI</h3>
                    <p class="text-sm text-zinc-muted">A <code class="inline-code">data:image/svg+xml,…</code> or base64-encoded data URL. Decoded and inlined.</p>
                  </div>
                </div>
              </div>

              <div class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <div class="flex items-start gap-4">
                  <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-none border border-coal-4 font-display text-base text-zinc-muted">3</div>
                  <div class="flex-1 min-w-0">
                    <h3 class="mb-1 font-semibold text-[#e8e8e8]">Remote URL</h3>
                    <p class="text-sm text-zinc-muted">Any <code class="inline-code">https://</code> URL. Fetched, parsed, cached in memory by URL, then inlined.</p>
                    <p data-fw-show="react vue svelte solid angular" class="mt-2 text-sm text-zinc-muted">Browser requests need the SVG server to send appropriate CORS headers. Pass credentials or custom headers with <code class="inline-code">fetchOptions</code>.</p>
                  </div>
                </div>
              </div>

              <div class="rounded-none border border-acid/20 bg-acid/5 p-5">
                <div class="flex items-start gap-4">
                  <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-none border border-acid/40 font-display text-base text-acid">★</div>
                  <div class="flex-1 min-w-0">
                    <h3 class="mb-1 font-semibold text-[#e8e8e8]">Local name (via <code class="inline-code text-sm">name</code> prop)</h3>
                    <p class="text-sm text-zinc-muted mb-2">
                      No path or URL needed. Provide a filename without extension.
                    </p>
                    <ul class="text-sm text-zinc-muted space-y-1 list-disc pl-5">
                      <li data-fw-show="astro" class="hidden">Add <code class="inline-code">@mhaadi/svg/astro/integration</code> to your integrations to discover local SVGs at build time.</li>
                      <li data-fw-show="react vue svelte solid angular">Vite projects can add <code class="inline-code">@mhaadi/svg/vite/plugin</code> to discover local SVGs at build time, documented under <a href="#local-discovery" class="text-acid hover:underline">Local discovery</a>.</li>
                      <li data-fw-show="react-native" class="hidden">Register local SVG strings with <code class="inline-code">registerLocalSvgs</code> from <code class="inline-code">@mhaadi/svg/local</code>.</li>
                      <li>Icon packages: <code class="inline-code">@mhaadi/svg/catalog</code> resolves <code class="inline-code">collection:icon</code> names (lucide, tabler, phosphor, hugeicons, any Iconify collection) from installed npm packages, without per-icon imports.</li>
                      <li data-fw-show="react vue svelte solid astro angular">Discovery checks <code class="inline-code">src/assets/svg/</code> then <code class="inline-code">app/assets/svg/</code>. Configure <code class="inline-code">dirs</code> for other folders. Nested files use names such as <code class="inline-code">social/github</code>.</li>
                      <li>Missing names are fetched from <code class="inline-code">/assets/svg/{"{name}"}.svg</code>.</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- LOCAL DISCOVERY -->
          <section id="local-discovery" class="mb-16">
            <h2 class="docs-heading">Local discovery</h2>
            <p class="docs-body" data-fw-show="react vue svelte solid astro angular">
              The Vite plugin scans your icon directories at build time and registers them, so
              <code class="inline-code">&lt;SVG name="social/github"&gt;</code> renders inline with no
              fetch and no per-icon import. Add the plugin once, then use local files by name.
              Catalog icons used anywhere in your source, such as
              <code class="inline-code">lucide:house</code>, are registered the same way — the
              source scan runs by default, no extra flag
              (<a href="#catalog-auto" class="text-acid hover:underline">catalog scanning</a>).
            </p>
            <p class="docs-body hidden" data-fw-show="react-native">
              React Native registers local sources ahead of build with
              <code class="inline-code">registerLocalSvgs</code> or pre-resolved
              <a href="#icon-catalog" class="text-acid hover:underline">bundled icons</a>. The
              Vite plugin below does not apply to it.
            </p>

            <div class="mt-6 space-y-6">
              <div class="rounded-none border border-coal-4 bg-coal-1 p-5" data-fw-show="react vue svelte solid angular">
                <p class="docs-body mb-3"><strong class="text-[#e8e8e8]">One entry in vite.config.ts:</strong></p>
                <CodeBlock code={`import { defineConfig } from "vite";
import localSvgs from "@mhaadi/svg/vite/plugin";

export default defineConfig({
  plugins: [
    localSvgs({
      // optional; default: ["src/assets/svg", "app/assets/svg"]
      dirs: ["src/icons", "src/illustrations"],
    }),
  ],
});`} lang="ts" file="vite.config.ts" />
                <p class="text-sm text-zinc-muted mt-3">
                  That is the whole setup. The plugin appends a <code class="inline-code">registerLocalSvgs</code>
                  call to every evaluation of <code class="inline-code">@mhaadi/svg</code>'s local-registry module,
                  so any <code class="inline-code">&lt;SVG name="..."&gt;</code> resolves without fetching. It also sets
                  <code class="inline-code">ssr.noExternal</code> and
                  <code class="inline-code">optimizeDeps.exclude</code> for <code class="inline-code">@mhaadi/svg</code>,
                  so server-rendered and dev-optimized builds pick up the registration.
                </p>
              </div>

              <div class="rounded-none border border-coal-4 bg-coal-1 p-5" data-fw-show="astro">
                <p class="docs-body mb-3"><strong class="text-[#e8e8e8]">Astro</strong> users add the integration, not the plugin:</p>
                <CodeBlock code={`import { defineConfig } from "astro/config";
import svgs from "@mhaadi/svg/astro/integration";

export default defineConfig({ integrations: [svgs()] });`} lang="ts" file="astro.config.mjs" />
                <p class="text-sm text-zinc-muted mt-3">
                  The integration wires up Vite under the hood and additionally makes
                  <code class="inline-code">name</code> resolve during server rendering without client JavaScript.
                </p>
              </div>

              <div class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <h3 class="font-semibold text-[#e8e8e8] mb-3">Name derivation</h3>
                <p class="text-sm text-zinc-muted mb-3">
                  A name is the file's path relative to its directory, <code class="inline-code">.svg</code>
                  stripped, directories joined with <code class="inline-code">/</code>:
                </p>
                <CodeBlock code={`dirs: ["src/icons"]

src/icons/logo.svg                 → name="logo"
src/icons/social/github.svg        → name="social/github"`} lang="text" />
                <ul class="text-sm text-zinc-muted space-y-1 list-disc pl-5 mt-3">
                  <li>Two directories listing the same name: the first configured directory wins.</li>
                  <li>Symlinked files are followed; symlink loops between directories are skipped.</li>
                  <li>Traversal is recursive: every <code class="inline-code">.svg</code> under each directory lands in the bundle. Keep icon-only folders.</li>
                  <li>Names registered by your own <code class="inline-code">registerLocalSvgs</code> calls always win, because the plugin registers with <code class="inline-code">override: false</code>.</li>
                  <li>A name the plugin did not find still falls back to <code class="inline-code">/assets/svg/{"{name}"}.svg</code>.</li>
                </ul>
                <p class="text-sm text-zinc-muted mt-3">
                  Names are normalized on the way in: leading slashes are trimmed and a trailing
                  <code class="inline-code">.svg</code> suffix is ignored, so
                  <code class="inline-code">"/icons/logo.svg"</code> resolves as
                  <code class="inline-code">icons/logo</code>. Within <code class="inline-code">dirs</code> paths
                  must be relative, slash-separated, without globs or <code class="inline-code">..</code>.
                </p>
              </div>

              <div class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <h3 class="font-semibold text-[#e8e8e8] mb-3">Development behavior</h3>
                <p class="text-sm text-zinc-muted">
                  Each configured directory is watched. Adding, editing, or deleting an SVG file
                  invalidates the module graph and triggers a full page reload. An absent directory
                  is skipped silently, not an error. Catalog scanning is on by default, and
                  scanned source files are watched the same way: a change that shifts the
                  registered set reloads the page.
                </p>
              </div>

              <div class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <h3 class="font-semibold text-[#e8e8e8] mb-3"><code class="inline-code">svgo</code> option</h3>
                <p class="text-sm text-zinc-muted mb-3">
                  Opt-in SVGO minification of files the plugin produces at build time. Install svgo yourself.
                  It is an optional peer of <code class="inline-code">@mhaadi/svg</code>, build-time only,
                  and never ships to the browser bundle. Discovered files and scanned catalog icons are
                  the only ones it touches: remote sources, <code class="inline-code">?raw</code> imports,
                  and hand-registered markup are never optimized.
                </p>
                <div class="prop-table-wrapper mt-4 overflow-x-auto">
                  <table class="prop-table">
                    <thead>
                      <tr><th>Form</th><th>Behavior</th></tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td><code class="font-mono text-xs text-acid">svgo: true</code></td>
                        <td class="text-zinc-muted text-sm">Curated safe preset: <code class="inline-code">preset-default</code> with <code class="inline-code">cleanupIds</code>, <code class="inline-code">removeDesc</code>, <code class="inline-code">minifyStyles</code>, and <code class="inline-code">removeDeprecatedAttrs</code> disabled. Those four plugins are the ones most likely to break id rewriting and accessibility references, so gradients/masks/clip paths keep working.</td>
                      </tr>
                      <tr>
                        <td><code class="font-mono text-xs text-acid">svgo: {"{ preset: 'safe', ... }"}</code></td>
                        <td class="text-zinc-muted text-sm">Same curated preset, spelled out, plus extra SVGO settings such as <code class="inline-code">multipass</code>, <code class="inline-code">floatPrecision</code>, and <code class="inline-code">js2svg</code>.</td>
                      </tr>
                      <tr>
                        <td><code class="font-mono text-xs text-acid">svgo: {"{ plugins: [...] }"}</code></td>
                        <td class="text-zinc-muted text-sm">Full passthrough. Names are validated against your installed svgo's built-in plugins; the exact settings you pick are forwarded unchanged, and unknown names fail the build.</td>
                      </tr>
                      <tr>
                        <td><code class="font-mono text-xs text-acid">svgo: (name) =&gt; ... | false</code></td>
                        <td class="text-zinc-muted text-sm">Per-file control. The function receives the discovered name ("social/github") and returns settings, or <code class="inline-code">false</code> to skip optimization for that file.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <p class="text-sm text-zinc-muted mt-4">
                  <code class="inline-code">filter: (name) =&gt; boolean</code> inside a settings object skips
                  optimization per file. It runs after the function form is evaluated and before svgo
                  is imported, so a filter that excludes everything never loads svgo at all. Works
                  without svgo installed.
                </p>
                <p class="text-sm text-zinc-muted mt-2">
                  <code class="inline-code">preset</code> and <code class="inline-code">plugins</code> are mutually
                  exclusive and the build fails with
                  <code class="inline-code">The "preset" option and the "plugins" list are incompatible; pass one or the other.</code>. SVGO
                  can only follow one strategy for choosing its plugin list, and the plugin refuses to
                  guess.
                </p>
                <CodeBlock code={`// extra settings on the curated preset
localSvgs({
  dirs: ["src/icons", "src/illustrations"],
  svgo: {
    filter: (name) => name.startsWith("social/"),
    multipass: true,
    floatPrecision: 3,
  },
});

// or a full passthrough with an explicit plugins list
localSvgs({
  dirs: ["src/icons"],
  svgo: { plugins: ["preset-default", { name: "cleanupIds" }, "removeViewBox"] },
});`} lang="ts" file="vite.config.ts" />
              </div>

              <div class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <h3 class="font-semibold text-[#e8e8e8] mb-3"><code class="inline-code">precompiled</code> option</h3>
                <p class="text-sm text-zinc-muted mb-3">
                  Turns discovery into build-time mode. The plugin parses (with
                  <code class="inline-code">@xmldom/xmldom</code>) and sanitizes every discovered file
                  during the build and registers the resulting tree instead of raw markup. When
                  <code class="inline-code">svgo</code> is on, the parse consumes the optimized markup. Mounting
                  <code class="inline-code">&lt;SVG name="..."&gt;</code> then skips XML parsing and the
                  sanitize pass entirely and only does per-instance work such as id scoping and color
                  overrides. The trade is bundle size. The parsed tree travels next to the registered markup.
                </p>
                <CodeBlock code={`localSvgs({ dirs: ["src/icons"], svgo: true, precompiled: true });`} lang="ts" />
                <ul class="text-sm text-zinc-muted space-y-1 list-disc pl-5 mt-3">
                  <li>Feed it only markup the plugin itself produced, never a hand-built tree.</li>
                  <li>At runtime the registration validates and re-sanitizes each tree and rejects malformed input with a build error.</li>
                  <li>On the server the priming parse is best-effort: a failed seed just costs a re-parse, never an error.</li>
                  <li>Inline SVG only: each entry must be a plain inline <code class="inline-code">{"<svg>"}</code> document (<code class="inline-code">Precompiled SVG "&lt;name&gt;" expects inline svg markup.</code> otherwise).</li>
                </ul>
              </div>

              <div class="rounded-none border border-amber-900/40 bg-amber-950/20 p-5">
                <p class="text-sm font-semibold text-amber-400 mb-2">Error messages</p>
                <p class="text-sm text-zinc-muted mb-3">Failures are wrapped with the file name so you can locate them without reading the source:</p>
                <div class="prop-table-wrapper mt-2 mb-4 overflow-x-auto">
                  <table class="prop-table">
                    <thead>
                      <tr><th>You did</th><th>Build fails with</th></tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td class="text-zinc-muted text-sm"><code class="inline-code">svgo</code> option set without svgo installed</td>
                        <td class="text-zinc-muted text-sm"><code class="inline-code">The SVGO pass is enabled, but "svgo" is not installed. Add svgo to your development dependencies (for example `pnpm add -D svgo`) and rerun the build.</code></td>
                      </tr>
                      <tr>
                        <td class="text-zinc-muted text-sm">An SVGO plugin errored on one file</td>
                        <td class="text-zinc-muted text-sm"><code class="inline-code">SVGO pass failed for "&lt;name&gt;": &lt;message&gt;</code></td>
                      </tr>
                      <tr>
                        <td class="text-zinc-muted text-sm"><code class="inline-code">preset</code> together with <code class="inline-code">plugins</code></td>
                        <td class="text-zinc-muted text-sm"><code class="inline-code">The "preset" option and the "plugins" list are incompatible; pass one or the other.</code></td>
                      </tr>
                      <tr>
                        <td class="text-zinc-muted text-sm">Unknown plugin name in a <code class="inline-code">plugins</code> list</td>
                        <td class="text-zinc-muted text-sm"><code class="inline-code">Unknown SVGO plugin "&lt;name&gt;". Known built-in plugins: &lt;sorted list&gt;.</code></td>
                      </tr>
                      <tr>
                        <td class="text-zinc-muted text-sm">Malformed SVG under <code class="inline-code">svgo</code></td>
                        <td class="text-zinc-muted text-sm"><code class="inline-code">svgo produced no markup, the SVG is likely malformed.</code></td>
                      </tr>
                      <tr>
                        <td class="text-zinc-muted text-sm"><code class="inline-code">dirs</code> with an absolute path, glob, or <code class="inline-code">..</code></td>
                        <td class="text-zinc-muted text-sm"><code class="inline-code">SVG directories must be paths relative to the project root without globs or '..'.</code></td>
                      </tr>
                      <tr>
                        <td class="text-zinc-muted text-sm">Non-SVG markup reaching <code class="inline-code">precompiled</code></td>
                        <td class="text-zinc-muted text-sm"><code class="inline-code">Precompile pass failed for "&lt;name&gt;": markup is not a valid SVG document.</code></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </section>

          <!-- ICON CATALOG -->
          <section id="icon-catalog" class="mb-16">
            <h2 class="docs-heading">Icon catalog</h2>
            <p class="docs-body">
              <code class="inline-code">@mhaadi/svg/catalog</code> resolves <code class="inline-code">collection:icon</code>
              names from icon packages installed in your <code class="inline-code">node_modules</code>. No
              network access, no per-icon imports. Registration runs in Node at build time, so it needs
              the filesystem; register the names you use up front and pass them
              to <code class="inline-code">name</code> like any local SVG. Browser-only projects bundle the
              icons into a generated data module instead.
            </p>

            <div class="mt-6 space-y-6">
              <div class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <h3 class="font-semibold text-[#e8e8e8] mb-3">Where names resolve from</h3>
                <p class="text-sm text-zinc-muted mb-3">
                  For each name, <code class="inline-code">node_modules</code> is walked upward from your
                  project root (or <code class="inline-code">searchPaths</code>). At each root, probes run in order:
                </p>
                <div class="prop-table-wrapper mt-2 overflow-x-auto">
                  <table class="prop-table">
                    <thead>
                      <tr><th>Package</th><th>What is read</th></tr>
                    </thead>
                    <tbody>
                      <tr><td class="text-zinc-muted text-sm"><code class="inline-code">@hugeicons/core-free-icons</code></td><td class="text-zinc-muted text-sm">hugeicons names, kebab-case (e.g. <code class="inline-code">hugeicons:home-01</code> for <code class="inline-code">Home01Icon</code>)</td></tr>
                      <tr><td class="text-zinc-muted text-sm"><code class="inline-code">@iconify-json/&lt;collection&gt;</code></td><td class="text-zinc-muted text-sm">Data package. Works for any Iconify collection.</td></tr>
                      <tr><td class="text-zinc-muted text-sm"><code class="inline-code">@iconify/json</code></td><td class="text-zinc-muted text-sm">Where the data package is installed instead.</td></tr>
                      <tr><td class="text-zinc-muted text-sm"><code class="inline-code">lucide-static</code></td><td class="text-zinc-muted text-sm">lucide names</td></tr>
                      <tr><td class="text-zinc-muted text-sm"><code class="inline-code">@tabler/icons</code></td><td class="text-zinc-muted text-sm">tabler names (<code class="inline-code">icons/outline/</code> first, then <code class="inline-code">icons/filled/</code>)</td></tr>
                      <tr><td class="text-zinc-muted text-sm"><code class="inline-code">@phosphor-icons/core</code></td><td class="text-zinc-muted text-sm">phosphor names, regular weight</td></tr>
                    </tbody>
                  </table>
                </div>
                <p class="text-sm text-zinc-muted mt-3">
                  Iconify lookups also follow <code class="inline-code">aliases</code> and parent icon
                  inheritance, and hidden icons resolve to nothing. Icons are always addressed by
                  their full <code class="inline-code">collection:icon</code> string, such
                  as <code class="inline-code">lucide:house</code>, never a bare icon name, and a
                  trailing <code class="inline-code">.svg</code> suffix is trimmed.
                </p>
              </div>

              <div class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <h3 class="font-semibold text-[#e8e8e8] mb-3">registerCatalogIcons</h3>
                <CodeBlock code={`import { registerCatalogIcons } from "@mhaadi/svg/catalog";

registerCatalogIcons(["lucide:house", "tabler:settings", "phosphor:bell"]);`} lang="ts" />
                <p class="text-sm text-zinc-muted mb-3 mt-3">
                  Hugeicons resolves from its official data package, so it needs
                  <code class="inline-code">@hugeicons/core-free-icons</code> installed. Names are
                  kebab-case versions of the package's own <code class="inline-code">PascalCaseIcon</code>
                  names:
                </p>
                <CodeBlock code={`import { registerCatalogIcons } from "@mhaadi/svg/catalog";

registerCatalogIcons(["hugeicons:home-01", "hugeicons:arrow-left-01"]);`} lang="ts" />
                <ul class="text-sm text-zinc-muted space-y-1 list-disc pl-5 mt-3">
                  <li>Runs in Node only, inside Astro SSR, React server components, or your build loop. It reads <code class="inline-code">node_modules</code>, which a browser bundle cannot. Browser-only projects use <a href="#catalog-bundle" class="text-acid hover:underline">bundleCatalogIcons</a> to write the icons into a data module instead.</li>
                  <li>Registration uses <code class="inline-code">override: false</code>, so local files and explicit <code class="inline-code">registerLocalSvgs</code> entries keep precedence over catalog icons.</li>
                  <li>Names accept a single trailing wildcard: <code class="inline-code">registerCatalogIcons(["lucide:*"])</code> registers every name the installed lucide source can serve, <code class="inline-code">["lucide:arrow*"]</code> matches a name prefix, and <a href="#catalog-bundle" class="text-acid hover:underline">bundleCatalogIcons</a> expands the same form for offline bundles. Wholesale expansion logs the icon count and approximate markup size once it exceeds 250 icons or 256 KB, and an explicit name in the same list still fails the bundle when it cannot resolve.</li>
                  <li>Returns the array of names that actually registered.</li>
                </ul>
                <p class="text-sm text-zinc-muted mt-3">
                  Registration <strong class="text-[#e8e8e8]">never errors</strong>. A misspelled icon or collection name is silently skipped. The name falls back to <code class="inline-code">/assets/svg/{"{name}"}.svg</code>, the fetch 404s, and the adapter's <code class="inline-code">fallback</code> state renders. Tell typos apart by diffing the return value against the input. Anything missing did not resolve from disk.
                </p>
              </div>

              <div class="rounded-none border border-coal-4 bg-coal-1 p-5" id="catalog-auto">
                <h3 class="font-semibold text-[#e8e8e8] mb-3">Automatic registration</h3>
                <p class="text-sm text-zinc-muted mb-3">
                  Vite-plugin projects skip the array entirely. The source scan is on by default,
                  and the plugin registers what your code actually references, resolved from the
                  same installed packages:
                </p>
                <CodeBlock code={`import { defineConfig } from "vite";
import localSvgs from "@mhaadi/svg/vite/plugin";

export default defineConfig({
  plugins: [localSvgs()], // scan on by default; catalog: false disables it
});`} lang="ts" file="vite.config.ts" />
                <ul class="text-sm text-zinc-muted space-y-1 list-disc pl-5 mt-3">
                  <li>When the scan finds nothing, no registration is appended and the build output is byte-identical — unused catalogs cost nothing.</li>
                  <li>The scan reads text files under the project root, skipping <code class="inline-code">node_modules</code>, <code class="inline-code">dist</code>, <code class="inline-code">.git</code>, and similar ignored directories, with the extensions <code class="inline-code">ts, tsx, js, jsx, mjs, astro, vue, svelte, html, mdx</code>, and matches <code class="inline-code">collection:icon</code> literals in the same alphabet the resolver validates.</li>
                  <li>Registration lands after the <code class="inline-code">dirs</code> scan with <code class="inline-code">override: false</code>, so local files and your own <code class="inline-code">registerLocalSvgs</code> calls keep precedence. <a href="#catalog-bundle" class="text-acid hover:underline">React Native</a> stays on bundled icons; the fallback chain is untouched.</li>
                  <li>A name whose collection is installed but that resolves to nothing logs a warning naming the files involved (a typo, or a hidden icon). <code class="inline-code">{`catalog: { strict: true }`}</code> escalates that case to a build error: <code class="inline-code">{"No source found for these catalog icons: lucide:hous (catalog scan strict mode)."}</code></li>
                  <li>A referenced collection with no installed package logs the install hint: <code class="inline-code">{"Add @iconify-json/lucide (or lucide-static) and rerun."}</code></li>
                  <li>Dynamic names built from template literals, <code class="inline-code">{"`lucide:${id}`"}</code>, cannot resolve by scanning; they log a hint pointing at <code class="inline-code">registerCatalogIcons</code> and keep rendering through the <code class="inline-code">/assets/svg/{"{name}"}.svg</code> fallback.</li>
                  <li>Warnings are advisory. Only <code class="inline-code">strict</code> fails the build, and only for names whose collection is installed.</li>
                  <li>Narrow the scan with <code class="inline-code">{`catalog: { include: ["src"] }`}</code>, add ignored paths with <code class="inline-code">exclude</code>, lower <code class="inline-code">maxFileBytes</code> (default 512 KB), or aim <code class="inline-code">searchPaths</code> at icon packages installed outside the project. <code class="inline-code">svgo</code> and <code class="inline-code">precompiled</code> apply to scanned icons exactly as they do to files from <code class="inline-code">dirs</code>.</li>
                </ul>
                <p class="text-sm text-zinc-muted mt-3">
                  The build prints one line when the scan registers something:
                  <code class="inline-code">{"[@mhaadi/svg] auto-registered 12 catalog icons from 9 source files (lucide: 10, tabler: 2)"}</code>.
                  In dev the scanned sources are watched: when a change shifts the registered set,
                  the module graph invalidates and the page reloads.
                </p>
              </div>

              <div class="rounded-none border border-coal-4 bg-coal-1 p-5">
                <h3 id="catalog-bundle" class="font-semibold text-[#e8e8e8] mb-3">bundleCatalogIcons, offline runtime</h3>
                <p class="text-sm text-zinc-muted mb-3">
                  Writes resolved icon sources into a plain data module your app imports, for runtimes
                  that cannot read <code class="inline-code">node_modules</code> or fetch at all, such
                  as a <a href="#framework-specifics" class="text-acid hover:underline">React Native</a> app
                  or a browser bundle without the <a href="#local-discovery" class="text-acid hover:underline">Vite plugin</a>. No per-icon import, no runtime lookup:
                </p>
                <div class="code-group">
                  <CodeBlock code={`import { bundleCatalogIcons } from "@mhaadi/svg/catalog";

bundleCatalogIcons({
  names: ["lucide:house", "tabler:settings"],
  out: "./src/icons/generated.ts",
});`} lang="ts" file="scripts/generate-icons.ts" />
                  <CodeBlock code={`export const bundledIcons: Record<string, string> = {
  "lucide:house": "<svg ...>",
  "tabler:settings": "<svg ...>",
};`} lang="ts" file="src/icons/generated.ts" />
                </div>
                <p class="text-sm text-zinc-muted mt-3">Register the map with the local registry your adapter already resolves <code class="inline-code">name</code> through, then render the icons by name:</p>
                <div data-fw-show="react-native" class="hidden">
                  <CodeBlock code={`import { SVG } from "@mhaadi/svg/react-native";
import { registerLocalSvgs } from "@mhaadi/svg/local";
import { bundledIcons } from "./icons/generated";

registerLocalSvgs(bundledIcons, { override: false });

const Home = () => <SVG name="lucide:house" size={24} />;
// renders inline, no fetch at runtime`} lang="tsx" />
                </div>
                <div data-fw-show="react vue svelte solid astro angular" class="hidden">
                  <CodeBlock code={`import { registerLocalSvgs } from "@mhaadi/svg/local";
import { bundledIcons } from "./icons/generated";

registerLocalSvgs(bundledIcons, { override: false });

// <SVG name="lucide:house" size={24} /> renders inline, no fetch at runtime`} lang="ts" file="src/icons/register.ts" />
                </div>
                <p class="text-sm text-zinc-muted mt-3">
                  <code class="inline-code">out</code> accepts <code class="inline-code">.ts</code>,
                  <code class="inline-code">.mts</code>, <code class="inline-code">.js</code>, or
                  <code class="inline-code">.mjs</code> (the extension picks the format; pass
                  <code class="inline-code">format</code> explicitly when <code class="inline-code">out</code> ends in
                  anything else); the default output is TypeScript. Errors are thrown, not logged:</p>
                <ul class="text-sm text-zinc-muted space-y-1 list-disc pl-5 mt-3">
                  <li>Any name without an installed source fails the whole script:<br /><code class="inline-code">No source found for these catalog icons: lucide:mistyped-name</code>. Fixing typos is a build error, not a runtime gap.</li>
                  <li>Unknown output extension:<br /><code class="inline-code">Unsupported bundle output extension: ./icons/data.txt. Use .ts, .mts, .js, or .mjs, or set format.</code></li>
                </ul>
              </div>
            </div>
          </section>

          <!-- SECURITY -->
          <section id="security" class="mb-16">
            <h2 class="docs-heading">Security</h2>
            <p class="docs-body">
              Sanitization is <strong class="text-[#e8e8e8]">enabled by default</strong> (<code class="inline-code">sanitize=true</code>).
              When active, the following are stripped from every SVG before rendering:
            </p>

            <div class="mt-6 grid sm:grid-cols-2 gap-3">
              {strippedElements.map((item) => (
                <div class="flex items-start gap-3 rounded-none border border-coal-4 bg-coal-1 px-4 py-3">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-acid" viewBox="0 0 16 16" fill="none">
                    <path d="M8 14s5.333-2.667 5.333-6.667V3.333L8 1.333 2.667 3.333v4C2.667 11.333 8 14 8 14z" stroke="currentColor" stroke-width="1.2"/>
                  </svg>
                  <div>
                    <code class="font-mono text-xs text-[#e8e8e8]">{item.elem}</code>
                    <p class="mt-0.5 text-xs text-zinc-muted">{item.reason}</p>
                  </div>
                </div>
              ))}
            </div>

            <p class="docs-body mt-6">
              The model is an element <strong class="text-[#e8e8e8]">allowlist</strong>: only static SVG
              elements survive sanitization. Scripts, embedded HTML, stylesheets, and
              SMIL animation elements sit outside it and are removed wholesale. Attributes are checked per
              element, and href-like attributes are matched by namespace-resolved local name, so
              <code class="inline-code">xlink:href</code>, re-prefixed spellings such as
              <code class="inline-code">evil:href</code>, and event handlers regardless of casing or
              namespace (<code class="inline-code">xlink:onclick</code>) are all covered. URL targets by element:
            </p>

            <div class="mt-6 prop-table-wrapper overflow-x-auto">
              <table class="prop-table">
                <thead>
                  <tr><th>Element</th><th>Allowed href-like targets</th></tr>
                </thead>
                <tbody>
                  <tr><td><code class="font-mono text-xs text-acid">use</code></td><td class="text-zinc-muted text-sm">Same-document fragments only (<code class="inline-code">{"#id"}</code>). Remote references such as <code class="inline-code">https:</code> and protocol-relative targets are stripped.</td></tr>
                  <tr><td><code class="font-mono text-xs text-acid">image / feImage</code></td><td class="text-zinc-muted text-sm">Same-document fragments, relative and remote URLs (protocol-relative included), <code class="inline-code">blob:</code>, and <code class="inline-code">{"data:image/*"}</code> targets other than inline SVG. <code class="inline-code">{"data:image/svg+xml"}</code> is stripped in all spellings, including compressed variants.</td></tr>
                  <tr><td><code class="font-mono text-xs text-acid">a</code></td><td class="text-zinc-muted text-sm">Same-document fragments, relative and remote URLs, and <code class="inline-code">blob:</code>. Every <code class="inline-code">data:</code> value is stripped, even raster ones.</td></tr>
                  <tr><td class="text-zinc-muted text-sm">any other element</td><td class="text-zinc-muted text-sm">Same-document fragments, relative and remote URLs, <code class="inline-code">blob:</code>, and any <code class="inline-code">{"data:image/*"}</code> target, including inline SVG data. Unknown schemes are stripped.</td></tr>
                  <tr><td><code class="font-mono text-xs text-acid">style</code> attribute</td><td class="text-zinc-muted text-sm"><code class="inline-code">url(...)</code> targets restricted to same-document fragments such as <code class="inline-code">fill:url(#g)</code>; remote and <code class="inline-code">data:</code> targets (including whitespace-padded <code class="inline-code">url (</code>) are stripped.</td></tr>
                </tbody>
              </table>
            </div>

            <div class="mt-6 rounded-none border border-amber-900/40 bg-amber-950/20 p-4">
              <div class="flex gap-3">
                <span class="mt-0.5 text-amber-400">⚠</span>
                <div>
                  <p class="text-sm font-semibold text-amber-400 mb-1">When to disable sanitization</p>
                  <p class="text-sm text-zinc-muted">
                    Only set <code class="inline-code">sanitize=false</code> when you <strong class="text-[#e8e8e8]">fully trust and control</strong> the SVG source.
                    Never disable sanitization for user-generated content, third-party CDNs, or any untrusted input.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- EDGE CASES -->
          <section id="edge-cases" data-fw-show="react react-native" class="mb-16">
            <h2 class="docs-heading">Edge Cases</h2>

            <div class="mt-4 space-y-6">
              <div data-fw-show="react">
                <h3 class="mb-2 font-semibold text-[#e8e8e8]">Server-side rendering (React)</h3>
                <p class="mb-3 text-sm text-zinc-muted leading-relaxed">
                  DOM parsing is unavailable on the server. Use the <code class="inline-code">loading</code> prop to render a placeholder during SSR. Without it the component renders nothing on the first pass.
                </p>
                                <CodeBlock code={`<SVG
  src={remoteUrl}
  loading={<div className="h-6 w-6 bg-zinc-800 rounded animate-pulse" />}
/>`} lang="tsx" />
              </div>

              <div data-fw-show="react react-native">
                <h3 class="mb-2 font-semibold text-[#e8e8e8]">Memoize fetchOptions</h3>
                <p class="mb-3 text-sm text-zinc-muted leading-relaxed">
                  <code class="inline-code">fetchOptions</code> should be stable across renders. Memoize it to prevent unnecessary re-fetches.
                </p>
                                <CodeBlock code={`const opts = useMemo(
  () => ({ headers: { Accept: "image/svg+xml" } }),
  []
);
<SVG src={url} fetchOptions={opts} />`} lang="tsx" />
              </div>

            </div>
          </section>

          <!-- EXAMPLES -->
          <section id="examples" data-fw-show="react react-native vue svelte" class="mb-16">
