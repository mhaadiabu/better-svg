{
  "name": "better-svg",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint:typecheck": "TSRS_FAST=1 oxlint --type-aware --type-check",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "dev:web": "turbo -F web dev",
    "deploy": "turbo -F @better-svg/infra deploy",
    "destroy": "turbo -F @better-svg/infra destroy",
    "check": "oxlint && oxfmt --write",
    "lint": "oxlint"
  },
  "dependencies": {
    "@better-svg/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-svg/config": "workspace:*",
    "@cloudflare/workers-types": "^4.20260702.1",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.92.0",
    "turbo": "^2.10.5",
    "tsrs": "catalog:"
  },
  "packageManager": "pnpm@11.15.1"
}
