---
import GitHubIcon from "../icons/github.svg";
import { frameworks } from "../data/frameworks";
import Base from "../layouts/Base.astro";
import HomeBenchmarks from "../components/HomeBenchmarks.astro";
import HomeCatalog from "../components/HomeCatalog.astro";
import InstallCommand from "../components/InstallCommand.astro";
import ReactLogo from "../icons/react.svg";
import VueLogo from "../icons/vue.svg";
import SvelteLogo from "../icons/svelte.svg";
import SolidLogo from "../icons/solid.svg";
import AstroLogo from "../icons/astro.svg";
import AngularLogo from "../icons/angular.svg";
import svgPkg from "../../../../packages/svg/package.json";

const version = svgPkg.version;

const logos = [
  { id: "react", label: "React and React Native", Logo: ReactLogo },
  { id: "vue", label: "Vue", Logo: VueLogo },
  { id: "svelte", label: "Svelte", Logo: SvelteLogo },
  { id: "solid", label: "Solid", Logo: SolidLogo },
  { id: "astro", label: "Astro", Logo: AstroLogo },
  { id: "angular", label: "Angular", Logo: AngularLogo },
];

const marqueeItems = [
  "React",
  "React Native",
  "Vue",
  "Svelte",
  "Solid",
  "Astro",
  "Angular",
  "inline rendering",
  "real <svg> elements",
  "sanitized by default",
  "remote URLs",
  "local names",
  "data: URIs",
  "memory caching",
  "loading & fallback",
];

const featureCards = [
  {
    icon: `<path d="M12 3v1m0 16v1M4.22 4.22l.707.707m12.728 12.728.707.707M1 12h2m18 0h2M4.22 19.78l.707-.707M18.071 5.929l.707-.707" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
    title: "Inline rendering",
    desc: "On the web it renders a real <svg> element, not an <img> tag. CSS currentColor, animations, and JavaScript work natively. React Native renders a react-native-svg tree.",
  },
  {
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
    title: "Built-in sanitization",
    desc: "Strips <script>, event handlers, unsafe hrefs, and embedded HTML by default. Untrusted markup never reaches the DOM in any framework.",
  },
  {
    icon: `<path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z" stroke="currentColor" stroke-width="1.5"/><polyline points="13 2 13 9 20 9" stroke="currentColor" stroke-width="1.5"/>`,
    title: "Four source types",
    desc: "Pass an inline SVG string, a data: URL, a remote HTTPS URL, or just a local name.",
  },
  {
    icon: `<ellipse cx="12" cy="12" rx="10" ry="4" stroke="currentColor" stroke-width="1.5"/><path d="M2 12c0 2.21 4.477 4 10 4s10-1.79 10-4" stroke="currentColor" stroke-width="1.5"/><path d="M2 16c0 2.21 4.477 4 10 4s10-1.79 10-4" stroke="currentColor" stroke-width="1.5"/>`,
    title: "Memory caching",
    desc: "Remote SVGs are cached in-memory by URL. No duplicate network requests on re-render.",
  },
  {
    icon: `<polyline points="16 18 22 12 16 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><polyline points="8 6 2 12 8 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
    title: "Full prop forwarding",
    desc: "React forwards every SVGProps attribute and it overrides markup attrs. React Native, Vue, and Svelte forward a focused subset: width, height, color/fill/stroke, and core a11y attrs.",
  },
  {
    icon: `<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v4l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
    title: "Loading & fallback",
    desc: "Render a loading state while fetching and a fallback state on error. Slots in Vue, snippets in Svelte.",
  },
  {
    icon: `<path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><polyline points="3.29 7 12 12 20.71 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="12" y1="22" x2="12" y2="12" stroke="currentColor" stroke-width="1.5"/>`,
    title: "Icon catalog",
    desc: "Install one icon package, like lucide, tabler, or hugeicons, and render collection:icon names through @mhaadi/svg/catalog. No per-icon imports, no network access.",
  },
  {
    icon: `<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><polyline points="7 10 12 15 17 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="12" y1="3" x2="12" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
    title: "Offline bundling",
    desc: "bundleCatalogIcons writes your icons into a generated data module. React Native registers it once and renders inline with zero network requests.",
  },
  {
    icon: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>`,
    title: "Build-time pipeline",
    desc: "Opt-in svgo and precompiled mode parse, sanitize, and optimize icon directories once at build. Mounting does zero parse work.",
  },
];
---

<Base title="BetterSVG: Inline SVG for React, React Native, Vue, Svelte, Solid, Astro, and Angular">
  <!-- NAV -->
  <nav class="sticky top-0 left-0 right-0 z-50 border-b border-coal-2 bg-coal/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 lg:px-4 py-3 lg:py-4">
      <a href="/" class="flex items-center gap-2.5 group">
        <svg class="h-6 w-6 text-acid group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 8 Q12 2 20 8 Q12 14 4 8Z" fill="currentColor" opacity="0.9"/>
          <path d="M4 16 Q12 10 20 16 Q12 22 4 16Z" fill="currentColor" opacity="0.4"/>
        </svg>
        <span class="font-display text-xl tracking-wider text-[#e8e8e8]">BETTERSVG</span>
      </a>

      <div class="hidden items-center gap-8 md:flex">
        <a href="/docs" class="link-underline text-sm text-zinc-muted hover:text-[#e8e8e8] transition-colors">Docs</a>
        <a href="/benchmarks" class="link-underline text-sm text-zinc-muted hover:text-[#e8e8e8] transition-colors">Benchmarks</a>
        <a href="/changelog" class="link-underline text-sm text-zinc-muted hover:text-[#e8e8e8] transition-colors">Changelog</a>
        <a href="https://github.com/mhaadiabu/better-svg" class="text-zinc-muted hover:text-[#e8e8e8] transition-colors" target="_blank" aria-label="BetterSVG on GitHub"><GitHubIcon class="h-5 w-5" aria-hidden="true" /></a>
        <a
          href="/docs"
          class="flex items-center gap-2 border border-acid bg-acid px-4 py-1.5 text-sm font-medium text-coal transition-all hover:bg-acid-dim hover:border-acid-dim"
        >
          Get started
        </a>
      </div>

      <button id="mobile-menu-btn" class="md:hidden text-zinc-muted hover:text-acid transition-colors p-1" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
          <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden border-t border-coal-2 px-4 py-4 md:hidden">
      <div class="flex flex-col gap-4">
        <a href="/docs" class="text-sm text-zinc-muted hover:text-acid transition-colors">Docs</a>
        <a href="/benchmarks" class="text-sm text-zinc-muted hover:text-acid transition-colors">Benchmarks</a>
        <a href="/changelog" class="text-sm text-zinc-muted hover:text-acid transition-colors">Changelog</a>
        <a href="https://github.com/mhaadiabu/better-svg" class="text-sm text-zinc-muted hover:text-acid transition-colors">GitHub</a>
        <a href="/docs" class="text-sm font-medium text-acid">Get started →</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section id="main-content" class="relative lg:min-h-screen overflow-x-hidden pt-4 lg:pt-8">
    <!-- Background grid -->
    <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-100 pointer-events-none"></div>

    <!-- Diagonal acid stripe -->
    <div
      class="absolute top-0 right-0 h-full w-[45%] pointer-events-none"
      style="background: linear-gradient(135deg, transparent 40%, rgba(185,255,75,0.03) 40%, rgba(185,255,75,0.05) 60%, transparent 60%);"
    ></div>

    <!-- Large SVG path decoration -->
    <svg class="absolute bottom-0 left-0 w-full opacity-[0.04] pointer-events-none" viewBox="0 0 1440 300" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 150 C200 50 400 250 600 150 S1000 50 1200 150 S1400 250 1440 150 L1440 300 L0 300Z" fill="#b9ff4b"/>
    </svg>

    <!-- Scan line effect -->
    <div class="scan-line"></div>

    <div class="relative mx-auto max-w-6xl px-4 pt-10 pb-16 lg:pt-20 lg:pb-32">
      <div class="grid lg:grid-cols-2 lg:gap-12 items-center">

        <!-- Left: Text -->
        <div class="min-w-0">

        <!-- Badge -->
        <div class="mb-8 inline-flex items-center gap-2 border border-coal-4 bg-coal-1 px-3 py-1.5 animate-fade-in delay-100">
          <span class="h-1.5 w-1.5 bg-acid animate-pulse"></span>
          <a href={`/changelog#${version.replaceAll(".", "")}`} aria-label={`Release notes for version ${version}`} class="font-mono text-xs text-zinc-muted hover:text-acid transition-colors">v{version}{version.includes("-") && " prerelease"}</a>
        </div>

        <!-- Headline -->
        <h1 class="font-display text-[clamp(2.75rem,6.5vw,5rem)] leading-[0.95] tracking-wider animate-fade-up delay-200">
          <span class="block text-[#e8e8e8]">ANY SVG.</span>
          <span class="block text-acid acid-glow">ANY FRAMEWORK.</span>
        </h1>

        <!-- Sub -->
        <p class="mt-6 max-w-md text-base text-zinc-muted leading-relaxed animate-fade-up delay-400">
          Render remote URLs, raw markup, local files, and icon packs as real inline{" "}
          <code class="font-mono text-sm text-[#e8e8e8]">&lt;svg&gt;</code> elements. One component per framework,
          sanitized by default.
        </p>

        <!-- CTA -->
        <div class="mt-8 flex flex-wrap items-stretch gap-3 animate-fade-up delay-600">
          <a
            href="/docs"
            class="group flex items-center gap-2 bg-acid px-5 py-2.5 text-sm font-semibold text-coal transition-all hover:bg-acid-dim hover:gap-3"
          >
            Read the docs
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <InstallCommand command="pnpm add @mhaadi/svg" />
        </div>

        <!-- Frameworks -->
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4 animate-fade-up delay-600">
          <span class="font-mono text-[10px] tracking-widest text-zinc-muted uppercase">Works with</span>
          <ul role="list" class="flex items-center gap-5">
            {logos.map(({ id, label, Logo }) => (
              <li>
                <a href={`/docs?fw=${id}`} aria-label={`${label} docs`} title={label} class="framework-logo block">
                  <Logo class="h-6 w-6" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </div>
        </div>

        <div class="mt-12 min-w-0 lg:mt-0">
          <HomeBenchmarks />
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE strip -->
  <div class="overflow-hidden border-y border-coal-2 bg-coal-1 py-3">
    <div class="marquee-track flex whitespace-nowrap gap-0">
      {
        Array.from({ length: 2 }).map((_, index) => (
          <span class="marquee-group" aria-hidden={index > 0 ? "true" : undefined}>
            {marqueeItems.map((item) => (
              <span class="inline-flex items-center gap-4 px-4 font-mono text-xs text-zinc-muted uppercase tracking-widest">
                <span class="h-1 w-1 bg-acid/40 shrink-0"></span>
                {item}
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <!-- FRAMEWORKS -->
  <section id="frameworks" class="border-y border-coal-2 bg-coal-1">
    <div class="mx-auto max-w-6xl px-4 py-16 lg:py-24">
      <div class="mb-10 lg:mb-14 flex items-end justify-between gap-4">
        <div>
          <p class="mb-2 font-mono text-xs tracking-widest text-acid uppercase">Seven adapters, one mental model</p>
          <h2 class="font-display text-5xl tracking-wider text-[#e8e8e8]">FRAMEWORKS</h2>
        </div>
        <a href="/docs" class="hidden sm:flex items-center gap-2 text-sm text-zinc-muted hover:text-acid transition-colors group">
          Read the API
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="grid gap-px bg-coal-2 sm:grid-cols-2 lg:grid-cols-4 overflow-hidden border border-coal-2">
        {frameworks.map((fw) => (
          <a href={`/docs?fw=${fw.id}`} class="group bg-coal p-6 hover:bg-coal-1 transition-colors flex flex-col gap-3">
            <div class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 bg-acid shrink-0"></span>
              <span class="font-mono text-[10px] tracking-widest text-zinc-muted uppercase">Adapter</span>
            </div>
            <h3 class="font-display text-2xl tracking-wider text-[#e8e8e8]">{fw.label}</h3>
            <code class="font-mono text-[11px] text-zinc-muted break-all">{fw.sub}</code>
              {fw.published === false && (
                <span class="mt-1 inline-block w-fit border border-amber-700/40 bg-amber-950/30 px-1.5 py-0.5 font-mono text-[10px] text-amber-400 uppercase tracking-widest">Coming soon</span>
              )}
            <div class="mt-auto flex items-center gap-1.5 font-mono text-[11px] text-zinc-muted group-hover:text-acid transition-colors">
              Read docs
              <svg class="h-3 w-3 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURES GRID -->
  <section id="features" class="mx-auto max-w-6xl px-4 py-16 lg:py-28">
    <div class="mb-10 lg:mb-16 flex items-end justify-between gap-4">
      <div>
        <p class="mb-2 font-mono text-xs tracking-widest text-acid uppercase">Why BetterSVG</p>
        <h2 class="font-display text-5xl tracking-wider text-[#e8e8e8]">FEATURES</h2>
      </div>
      <a href="/docs" class="hidden sm:flex items-center gap-2 text-sm text-zinc-muted hover:text-acid transition-colors group">
        Full API reference
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <div class="grid gap-px bg-coal-2 sm:grid-cols-2 lg:grid-cols-3 overflow-hidden border border-coal-2">
      {featureCards.map((feature) => (
        <div class="group bg-coal p-7 hover:bg-coal-1 transition-colors">
          <div class="mb-4 flex h-10 w-10 items-center justify-center border border-coal-4 bg-coal-1 group-hover:border-acid/30 transition-colors">
            <svg class="h-5 w-5 text-acid" viewBox="0 0 24 24" fill="none" set:html={feature.icon} />
          </div>
          <h3 class="mb-2 font-semibold text-[#e8e8e8]">{feature.title}</h3>
          <p class="text-sm text-zinc-muted leading-relaxed">{feature.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ICON CATALOG -->
  <HomeCatalog />

  <!-- CTA FOOTER BAND -->
  <section class="border-t border-coal-2 bg-[#0d0d0d]">
    <div class="mx-auto max-w-6xl px-4 py-16 lg:py-24 text-center">
      <h2 class="font-display text-[clamp(3rem,8vw,6rem)] tracking-wider text-[#e8e8e8] leading-none">
        SHIP<br/><span class="text-acid acid-glow">BETTER SVG</span><span class="opacity-30"> TODAY.</span>
      </h2>
      <p class="mt-6 mx-auto max-w-md text-zinc-muted">
        One mental model. Seven frameworks. Every SVG format, sanitized by
        default.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/docs" class="bg-acid px-8 py-3 font-semibold text-coal hover:bg-acid-dim transition-colors">
          Read the docs
        </a>
        <a href="https://github.com/mhaadiabu/better-svg" target="_blank" class="border border-coal-4 px-8 py-3 text-zinc-muted hover:border-acid hover:text-acid transition-colors">
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t border-coal-2 bg-coal">
    <div class="mx-auto max-w-6xl px-4 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <svg class="h-5 w-5 text-acid" viewBox="0 0 24 24" fill="none">
          <path d="M4 8 Q12 2 20 8 Q12 14 4 8Z" fill="currentColor" opacity="0.9"/>
          <path d="M4 16 Q12 10 20 16 Q12 22 4 16Z" fill="currentColor" opacity="0.4"/>
        </svg>
        <span class="font-display tracking-wider text-[#e8e8e8]">BETTERSVG</span>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="/docs" class="text-xs text-zinc-muted hover:text-acid transition-colors">Docs</a>
        <a href="/benchmarks" class="text-xs text-zinc-muted hover:text-acid transition-colors">Benchmarks</a>
        <a href="/changelog" class="text-xs text-zinc-muted hover:text-acid transition-colors">Changelog</a>
        <a href="https://github.com/mhaadiabu/better-svg" target="_blank" class="text-xs text-zinc-muted hover:text-acid transition-colors">GitHub</a>
        <a href="https://www.npmjs.com/package/@mhaadi/svg" target="_blank" class="text-xs text-zinc-muted hover:text-acid transition-colors">npm</a>
      </div>
      <p class="text-xs text-[#3a3a3a]">MIT License · {new Date().getFullYear()}</p>
    </div>
  </footer>
</Base>

<script>
  let cleanup = () => {};

  function initLandingPage() {
    cleanup();

    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const toggleMenu = () => {
      menu?.classList.toggle("hidden");
    };
    btn?.addEventListener("click", toggleMenu);

    // Active sidebar links on scroll (for single-page sections)
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("a[href^='#']");

    function onScroll() {
      let current = "";
      sections.forEach((section) => {
        const top = (section as HTMLElement).offsetTop - 100;
        if (window.scrollY >= top) {
          current = section.getAttribute("id") || "";
        }
      });
      navLinks.forEach((a) => {
        a.classList.toggle("text-acid", (a as HTMLAnchorElement).getAttribute("href") === `#${current}`);
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    cleanup = () => {
      btn?.removeEventListener("click", toggleMenu);
      window.removeEventListener("scroll", onScroll);
    };
  }

  document.addEventListener("astro:page-load", initLandingPage);
  document.addEventListener("astro:before-swap", () => cleanup());
  initLandingPage();
</script>
